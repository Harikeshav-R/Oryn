        "gaps",
        "unresolved_failure_refs",
        "evidence_manifest_sha256",
        "evidence_valid_until",
        "signed_at"
      ],
      "properties": {
        "report_id": { "$ref": "#/$defs/UUID" },
        "organization_id": { "$ref": "#/$defs/UUID" },
        "evaluation_id": { "$ref": "#/$defs/UUID" },
        "target_identity": { "$ref": "#/$defs/EvaluationTargetIdentityV1" },
        "suite_version_id": { "$ref": "#/$defs/UUID" },
        "suite_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "mode": { "type": "string", "enum": ["live", "recorded_diagnostic"] },
        "requested_stage": { "type": "integer", "enum": [3, 4] },
        "evaluated_scope": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "maxItems": 64
        },
        "conditions_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "attempt_manifest_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "oracle_results_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "coverage_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "completion": {
          "type": "string",
          "enum": ["completed", "incomplete", "canceled", "blocked"]
        },
        "assessment": {
          "type": "string",
          "enum": ["pass", "fail", "incomplete"]
        },
        "scenario_results_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "content_sha256", "byte_length"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/UUID" },
            "content_sha256": { "$ref": "#/$defs/Sha256Hex" },
            "byte_length": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          }
        },
        "mandatory_check_results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_branches_covered",
            "policy_probes_passed",
            "no_unauthorized_actions",
            "no_unhandled_exceptions",
            "prescribed_trials_passed"
          ],
          "properties": {
            "all_branches_covered": { "type": "boolean" },
            "policy_probes_passed": { "type": "boolean" },
            "no_unauthorized_actions": { "type": "boolean" },
            "no_unhandled_exceptions": { "type": "boolean" },
            "prescribed_trials_passed": { "type": "boolean" }
          }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 64
        },
        "unresolved_failure_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SimulationVersionRefV1" },
          "maxItems": 128
        },
        "evidence_manifest_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "evidence_valid_until": { "$ref": "#/$defs/UtcDateTime" },
        "signed_at": { "$ref": "#/$defs/UtcDateTime" }
      }
