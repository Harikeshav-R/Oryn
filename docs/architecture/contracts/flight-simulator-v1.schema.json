    "SimulationRegressionRequirementV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "organization_id",
        "requirement_id",
        "version_id",
        "incident_refs",
        "repair_ref",
        "base_target",
        "original_scenario_refs",
        "prevention_spec_refs",
        "variation_parent_refs",
        "changed_dimensions",
        "content_sha256",
        "created_by",
        "created_at"
      ],
      "properties": {
        "schema_id": { "const": "simulation.regression-requirement.v1" },
        "organization_id": { "$ref": "#/$defs/UUID" },
        "requirement_id": { "$ref": "#/$defs/UUID" },
        "version_id": { "$ref": "#/$defs/UUID" },
        "incident_refs": {
          "type": "array",
          "items": { "$ref": "urn:oryn:schemas:incident-correction-repair:v1#/$defs/IncidentRefV1" },
          "minItems": 1,
          "maxItems": 32
        },
        "repair_ref": { "$ref": "urn:oryn:schemas:incident-correction-repair:v1#/$defs/RepairRefV1" },
        "base_target": { "$ref": "#/$defs/EvaluationTargetV1" },
        "original_scenario_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SimulationScenarioRefV1" },
          "minItems": 0,
          "maxItems": 64
        },
        "prevention_spec_refs": {
          "type": "array",
          "items": { "$ref": "urn:oryn:schemas:incident-correction-repair:v1#/$defs/PreventionSpecRefV1" },
          "minItems": 0,
          "maxItems": 64
        },
        "variation_parent_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SimulationScenarioRefV1" },
          "maxItems": 64
        },
        "changed_dimensions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 32
        },
        "content_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "created_by": { "$ref": "#/$defs/Identifier" },
        "created_at": { "$ref": "#/$defs/UtcDateTime" }
      },
      "anyOf": [
        {
          "properties": {
            "original_scenario_refs": { "minItems": 1 }
          },
          "required": ["original_scenario_refs"]
        },
        {
          "properties": {
            "prevention_spec_refs": { "minItems": 1 }
          },
          "required": ["prevention_spec_refs"]
        }
      ]
    },
    "EvaluationReportPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "organization_id",
        "evaluation_id",
        "target_identity",
        "suite_version_id",
        "suite_sha256",
        "mode",
        "requested_stage",
        "evaluated_scope",
        "conditions_sha256",
        "attempt_manifest_sha256",
        "oracle_results_sha256",
        "coverage_sha256",
        "completion",
        "assessment",
        "scenario_results_ref",
