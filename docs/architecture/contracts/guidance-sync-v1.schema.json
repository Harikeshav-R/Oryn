{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oryn:schemas:guidance-sync:v1",
  "title": "Oryn Guidance Synchronization and Cache Wire Schemas (v1)",
  "description": "Normative Draft 2020-12 wire schemas for Oryn guidance manifests, immutable bundles, access leases, and atomic HUD generation IPC.",
  "oneOf": [
    {
      "$ref": "#/$defs/GuidanceLeaseRequestV1"
    },
    {
      "$ref": "#/$defs/SignedGuidanceAccessLeaseV1"
    },
    {
      "$ref": "#/$defs/SignedTrustKeysetV1"
    },
    {
      "$ref": "#/$defs/SignedPublisherSignatureV1"
    },
    {
      "$ref": "#/$defs/SignedGuidanceBundleV1"
    },
    {
      "$ref": "#/$defs/GuidanceManifestPageV1"
    },
    {
      "$ref": "#/$defs/AssistEvaluationBundleV1"
    },
    {
      "$ref": "urn:oryn:schemas:contribution-sync:v1#/$defs/SyncProblemV1"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "OrganizationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "UUIDv4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "U64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "PlaybookVersion": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^.*Z$"
    },
    "Signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "PublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,1024}$"
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Scalar": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/SafeInteger"
        },
        {
          "type": "string",
          "maxLength": 512
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/Predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/Predicate"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "exists"
          ],
          "additionalProperties": false,
          "properties": {
            "exists": {
              "type": "object",
              "required": [
                "field"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "eq"
          ],
          "additionalProperties": false,
          "properties": {
            "eq": {
              "type": "object",
              "required": [
                "field",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "value": {
                  "$ref": "#/$defs/Scalar"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "enum_in"
          ],
          "additionalProperties": false,
          "properties": {
            "enum_in": {
              "type": "object",
              "required": [
                "field",
                "values"
              ],
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "$ref": "#/$defs/Scalar"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "GuidanceStepEdgeV1": {
      "type": "object",
      "required": [
        "from_step_id",
        "to_step_id",
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "from_step_id": {
          "$ref": "#/$defs/Identifier"
        },
        "to_step_id": {
          "$ref": "#/$defs/Identifier"
        },
        "condition": {
          "oneOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GuidanceStepV1": {
      "type": "object",
      "required": [
        "step_id",
        "order",
        "label",
        "description",
        "target_key",
        "application_profile_id",
        "predicate",
        "timeout_ms",
        "assist_plan_ref",
        "rule_refs",
        "source_refs",
        "allowed_targets"
      ],
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "$ref": "#/$defs/Identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "target_key": {
          "$ref": "#/$defs/Identifier"
        },
        "application_profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "predicate": {
          "oneOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 300000
        },
        "assist_plan_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "allowed_targets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "application_profile_id",
              "target_key"
            ],
            "additionalProperties": false,
            "properties": {
              "application_profile_id": {
                "$ref": "#/$defs/Identifier"
              },
              "target_key": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        }
      }
    },
    "PeerFixV1": {
      "type": "object",
      "required": [
        "peer_fix_id",
        "application_profile_id",
        "profile_version",
        "normalized_error_code",
        "state_predicate",
        "fix_playbook_version",
        "provenance",
        "permitted_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "peer_fix_id": {
          "$ref": "#/$defs/Identifier"
        },
        "application_profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "normalized_error_code": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "state_predicate": {
          "oneOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "fix_playbook_version": {
          "$ref": "#/$defs/PlaybookVersion"
        },
        "provenance": {
          "const": "peer_verified"
        },
        "permitted_actions": {
          "enum": [
            "guidance",
            "guidance_and_assist"
          ]
        }
      }
    },
    "AssistPlanActionBindingV1": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "$ref": "#/$defs/Scalar" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "variable_name"],
          "properties": {
            "kind": { "const": "variable" },
            "variable_name": { "$ref": "#/$defs/Identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_action_id", "json_pointer"],
          "properties": {
            "kind": { "const": "read_result" },
            "source_action_id": { "$ref": "#/$defs/Identifier" },
            "json_pointer": { "type": "string" }
          }
        }
      ]
    },
    "AssistPlanActionV1": {
      "type": "object",
      "required": [
        "action_id",
        "step_id",
        "action_order",
        "operation",
        "target_key",
        "risk_tier",
        "declared_effects",
        "stopping_point",
        "timeout_ms",
        "expected_state",
        "argument_bindings",
        "result_bindings",
        "capability_ref",
        "adapter_operation_id",
        "verification_requirement_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/Identifier"
        },
        "step_id": {
          "$ref": "#/$defs/Identifier"
        },
        "action_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "operation": {
          "enum": [
            "read",
            "click",
            "fill",
            "select",
            "check",
            "navigate"
          ]
        },
        "target_key": {
          "$ref": "#/$defs/Identifier"
        },
        "risk_tier": {
          "enum": [
            "tier_1",
            "tier_2",
            "tier_3"
          ]
        },
        "declared_effects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "stopping_point": {
          "enum": [
            "stop_before_commit",
            "review_and_submit",
            "none"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "argument_bindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AssistPlanActionBindingV1"
          }
        },
        "result_bindings": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            {
              "type": "null"
            }
          ]
        },
        "capability_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "adapter_operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "verification_requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 64
        },
        "expected_state": {
          "type": "object",
          "required": [
            "record_revision",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "record_revision": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 0,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "field_key",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "field_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "value": {
                    "$ref": "#/$defs/Scalar"
                  }
                }
              }
            }
          }
        }
      }
    },
    "AssistPlanEligibilityV1": {
      "type": "object",
      "required": [
        "eligibility_id",
        "organization_id",
        "assist_plan_id",
        "assist_plan_version",
        "plan_sha256",
        "playbook_version",
        "rule_versions",
        "application_profile_versions",
        "evaluation_id",
        "suite_version",
        "verified_example_count",
        "passed_scenario_count",
        "edge_negative_count",
        "mandatory_checks_passed",
        "all_branches_covered",
        "owner_approval_ref",
        "separation_of_duties_satisfied",
        "allowed_scope",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "eligibility_id": {
          "$ref": "#/$defs/Identifier"
        },
        "organization_id": {
          "$ref": "#/$defs/OrganizationId"
        },
        "assist_plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "assist_plan_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "playbook_version": {
          "$ref": "#/$defs/PlaybookVersion"
        },
        "rule_versions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "application_profile_versions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "evaluation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "suite_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified_example_count": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "passed_scenario_count": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "edge_negative_count": {
          "$ref": "#/$defs/NonNegativeSafeInteger"
        },
        "mandatory_checks_passed": {
          "type": "boolean"
        },
        "all_branches_covered": {
          "type": "boolean"
        },
        "owner_approval_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "separation_of_duties_satisfied": {
          "type": "boolean"
        },
        "allowed_scope": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "status": {
          "const": "approved"
        }
      }
    },
    "AssistExecutableBodyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "assist_plan_id",
        "assist_plan_version",
        "playbook_version",
        "allowed_applications",
        "allowed_transitions",
        "allowed_record_types",
        "variables",
        "actions",
        "guidance_semantics",
        "verification_requirements",
        "dependencies"
      ],
      "properties": {
        "organization_id": {
          "$ref": "#/$defs/OrganizationId"
        },
        "assist_plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "assist_plan_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "playbook_version": {
          "$ref": "#/$defs/PlaybookVersion"
        },
        "allowed_applications": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "allowed_transitions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "allowed_record_types": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "variables": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "required"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/Identifier"
              },
              "type": {
                "enum": [
                  "string",
                  "decimal",
                  "integer",
                  "boolean"
                ]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/AssistPlanActionV1"
          }
        },
        "guidance_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_edges",
            "application_profiles",
            "rule_versions"
          ],
          "properties": {
            "step_edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from_step_id",
                  "to_step_id"
                ],
                "properties": {
                  "from_step_id": {
                    "$ref": "#/$defs/Identifier"
                  },
                  "to_step_id": {
                    "$ref": "#/$defs/Identifier"
                  }
                }
              }
            },
            "application_profiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Identifier"
              }
            },
            "rule_versions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        },
        "verification_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 128
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dependency_id",
              "kind",
              "version_id",
              "content_sha256"
            ],
            "properties": {
              "dependency_id": {
                "$ref": "#/$defs/Identifier"
              },
              "kind": {
                "type": "string"
              },
              "version_id": {
                "$ref": "#/$defs/Identifier"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "maxItems": 256
        }
      }
    },
    "AssistPlanV1": {
      "type": "object",
      "required": [
        "body",
        "plan_sha256",
        "owner_approval_ref",
        "eligibility"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/AssistExecutableBodyV1"
        },
        "plan_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner_approval_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "eligibility": {
          "$ref": "#/$defs/AssistPlanEligibilityV1"
        }
      }
    },
    "AssistEvaluationBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "organization_id",
        "body",
        "plan_sha256",
        "dependency_manifest",
        "attestation",
        "evaluation_target"
      ],
      "properties": {
        "schema_id": {
          "const": "hud.assist-evaluation-bundle.v1"
        },
        "organization_id": {
          "$ref": "#/$defs/OrganizationId"
        },
        "body": {
          "$ref": "#/$defs/AssistExecutableBodyV1"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependency_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_kind",
              "entity_id",
              "version_id",
              "content_sha256"
            ],
            "properties": {
              "entity_kind": {
                "type": "string"
              },
              "entity_id": {
                "$ref": "#/$defs/Identifier"
              },
              "version_id": {
                "$ref": "#/$defs/Identifier"
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "signature",
            "signed_at"
          ],
          "properties": {
            "key_id": {
              "$ref": "#/$defs/Identifier"
            },
            "signature": {
              "$ref": "#/$defs/Signature"
            },
            "signed_at": {
