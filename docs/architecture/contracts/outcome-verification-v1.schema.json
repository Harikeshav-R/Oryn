{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oryn:schemas:outcome-verification:v1",
  "title": "Oryn Outcome Verification Projection Wire Schemas (v1)",
  "description": "Normative Draft 2020-12 wire schemas for verification specification projections, live verifier status, and verification requirements.",
  "oneOf": [
    {
      "$ref": "#/$defs/VerificationSpecProjectionV1"
    },
    {
      "$ref": "#/$defs/VerificationSpecStatusV1"
    },
    {
      "$ref": "#/$defs/VerificationRequirementV1"
    },
    {
      "$ref": "#/$defs/VerificationRunRequestV1"
    },
    {
      "$ref": "#/$defs/VerificationRunResultV1"
    },
    {
      "$ref": "#/$defs/VerificationStatusQueryV1"
    },
    {
      "$ref": "#/$defs/VerificationRunStatusV1"
    },
    {
      "$ref": "#/$defs/VerificationErrorV1"
    }
  ],
  "$defs": {
    "VerificationSpecProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "organization_id",
        "spec_ref",
        "body"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "verification.spec-projection.v1"
        },
        "organization_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Uuid"
        },
        "spec_ref": {
          "allOf": [
            {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
            },
            {
              "type": "object",
              "properties": {
                "entity_kind": {
                  "const": "verification_spec"
                }
              }
            }
          ]
        },
        "body": {
          "$ref": "#/$defs/VerificationSpecProjectionBodyV1"
        }
      }
    },
    "VerificationSpecProjectionBodyV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_ref",
            "postcondition_ids",
            "method",
            "fact_definitions",
            "predicate",
            "readback_capability_ref",
            "readback_operation_id",
            "reviewer_role",
            "supported_stages"
          ],
          "properties": {
            "capability_ref": {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
            },
            "postcondition_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
              }
            },
            "method": {
              "const": "system_evidence"
            },
            "fact_definitions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/BusinessFactDefinitionV1"
              }
            },
            "predicate": {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/BusinessConditionV1"
            },
            "readback_capability_ref": {
              "$ref": "urn:oryn:schemas:application-capability:v1#/$defs/ApplicationCapabilityRefV1"
            },
            "readback_operation_id": {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
            },
            "reviewer_role": {
              "type": "null"
            },
            "supported_stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "enum": [3, 4, 5]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_ref",
            "postcondition_ids",
            "method",
            "fact_definitions",
            "predicate",
            "readback_capability_ref",
            "readback_operation_id",
            "reviewer_role",
            "supported_stages"
          ],
          "properties": {
            "capability_ref": {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
            },
            "postcondition_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
              }
            },
            "method": {
              "const": "authorized_reviewer"
            },
            "fact_definitions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/BusinessFactDefinitionV1"
              }
            },
            "predicate": {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/BusinessConditionV1"
            },
            "readback_capability_ref": {
              "type": "null"
            },
            "readback_operation_id": {
              "type": "null"
            },
            "reviewer_role": {
              "$ref": "urn:oryn:schemas:identity-policy:v1#/$defs/RoleId"
            },
            "supported_stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "const": 3
              }
            }
          }
        }
      ]
    },
    "VerificationSpecStatusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "organization_id",
        "spec_ref",
        "generation",
        "status",
        "observed_at"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "verification.spec-status.v1"
        },
        "organization_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Uuid"
        },
        "spec_ref": {
          "allOf": [
            {
              "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
            },
            {
              "type": "object",
              "properties": {
                "entity_kind": {
                  "const": "verification_spec"
                }
              }
            }
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "revoked",
            "unknown"
          ]
        },
        "observed_at": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Timestamp"
        }
      }
    },
    "VerificationRequirementV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "capability_ref",
        "postcondition_id",
        "spec_ref",
        "action_node_ids",
        "required_before_node_ids",
        "on_unknown",
        "on_mismatch"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
        },
        "capability_ref": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
        },
        "postcondition_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
        },
        "spec_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/KnowledgeVersionRefV1"
                },
                {
                  "type": "object",
                  "properties": {
                    "entity_kind": {
                      "const": "verification_spec"
                    }
                  }
                }
              ]
            }
          ]
        },
        "action_node_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          }
        },
        "required_before_node_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          }
        },
        "on_unknown": {
          "const": "pause_case"
        },
        "on_mismatch": {
          "const": "pause_case"
        }
      }
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "UUIDv4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "U64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "UtcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "RequirementResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "verdict",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
        },
        "verdict": {
          "type": "string",
          "enum": ["verified", "mismatch", "unknown"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          },
          "maxItems": 256
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        }
      }
    },
    "VerificationRunRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "request_id",
        "organization_id",
        "execution_context",
        "agent_version_id",
        "behavior_sha256",
        "requirement_ids",
        "action_ids",
        "checkpoint_revision",
        "environment"
      ],
      "properties": {
        "schema_id": {
          "const": "verification.run-request.v1"
        },
        "request_id": {
          "$ref": "#/$defs/UUIDv4"
        },
        "organization_id": {
          "$ref": "#/$defs/UUID"
        },
        "execution_context": {
          "$ref": "urn:oryn:schemas:identity-policy:v1#/$defs/ExecutionContextV1"
        },
        "agent_version_id": {
          "$ref": "#/$defs/UUID"
        },
        "behavior_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          },
          "maxItems": 256
        },
        "action_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          },
          "maxItems": 256
        },
        "checkpoint_revision": {
          "$ref": "#/$defs/U64"
        },
        "environment": {
          "type": "string",
          "enum": ["production", "simulation"]
        }
      }
    },
    "VerificationRunResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "request_id",
        "verification_id",
        "organization_id",
        "execution_context",
        "behavior_sha256",
        "requirement_results",
        "verdict",
        "evidence_refs",
        "verified_at"
      ],
      "properties": {
        "schema_id": {
          "const": "verification.run-result.v1"
        },
        "request_id": {
          "$ref": "#/$defs/UUIDv4"
        },
        "verification_id": {
          "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
        },
        "organization_id": {
          "$ref": "#/$defs/UUID"
        },
        "execution_context": {
          "$ref": "urn:oryn:schemas:identity-policy:v1#/$defs/ExecutionContextV1"
        },
        "behavior_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "requirement_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementResultV1"
          },
          "maxItems": 256
        },
        "verdict": {
          "type": "string",
          "enum": ["verified", "mismatch", "unknown"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:oryn:schemas:operational-graph:v1#/$defs/Identifier"
          },
          "maxItems": 256
        },
        "verified_at": {
          "$ref": "#/$defs/UtcDateTime"
        }
      }
    },
    "VerificationStatusQueryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "organization_id",
        "execution_context",
        "request_id"
      ],
      "properties": {
        "schema_id": {
          "const": "verification.status-query.v1"
        },
        "organization_id": {
          "$ref": "#/$defs/UUID"
        },
        "execution_context": {
          "$ref": "urn:oryn:schemas:identity-policy:v1#/$defs/ExecutionContextV1"
        },
        "request_id": {
          "$ref": "#/$defs/UUIDv4"
        }
      }
    },
    "VerificationRunStatusV1": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_id", "state", "request_id"],
          "properties": {
            "schema_id": {
              "const": "verification.run-status.v1"
            },
            "state": {
              "const": "pending"
            },
            "request_id": {
              "$ref": "#/$defs/UUIDv4"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_id", "state", "result"],
          "properties": {
            "schema_id": {
              "const": "verification.run-status.v1"
            },
            "state": {
              "const": "complete"
            },
            "result": {
              "$ref": "#/$defs/VerificationRunResultV1"
            }
          }
        }
      ]
    },
    "VerificationErrorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "request_id"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VERIFICATION_NOT_AUTHORIZED",
            "VERIFICATION_INPUT_INVALID",
            "VERIFICATION_UNAVAILABLE",
            "VERIFICATION_REQUEST_CONFLICT"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/UUIDv4"
        }
      }
    }
  }
}
